{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mapadeingresos.ar" }],
      "destination": "https://www.mapadeingresos.ar/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mapadeingresos.ar" }],
      "destination": "https://www.mapadeingresos.ar/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
