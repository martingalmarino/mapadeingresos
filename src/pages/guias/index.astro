---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Graphic from '../../components/Graphic.astro';
import { slugOf } from '../../lib/catalog';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { formatDisplayDate, guidePath } from '../../lib/urls';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const guideArt = {
  'programas-afiliados-argentina': 'choose',
  'como-monetizar-una-web': 'web',
  'modelos-monetizacion-digital': 'evidence',
  'vender-productos-digitales-argentina': 'products',
  'cobrar-plataformas-internacionales-argentina': 'argentina',
  'alternativas-google-adsense': 'web',
} as const;
---

<ArticleLayout
  title="Guías para generar ingresos online"
  description="Guías para elegir un modelo, comparar programas de afiliados, monetizar una web y verificar el cobro desde Argentina."
  path="/guias/"
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Guías' },
  ]}
  jsonLd={[breadcrumbJsonLd([{ name: 'Inicio', url: '/' }, { name: 'Guías', url: '/guias/' }])]}
>
  <h1>Guías para decidir cómo monetizar</h1>
  <p class="lede">Seis lecturas con intención distinta: modelos, afiliados, una página web, productos digitales, alternativas a AdSense y cobro desde Argentina. No son rankings ni recetas de ingresos.</p>
  <div class="guides-grid">
    {
      guides.map((guide) => (
        <a class="guide-card" href={guidePath(slugOf(guide))}>
          <Graphic name={guideArt[slugOf(guide) as keyof typeof guideArt] ?? 'choose'} />
          <h2>{guide.data.title}</h2>
          <p>{guide.data.summary}</p>
          <p class="fact-line">{formatDisplayDate(guide.data.publishedAt)}</p>
        </a>
      ))
    }
  </div>
</ArticleLayout>
