---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectoryFilters from '../../components/DirectoryFilters.astro';
import OpportunityCard from '../../components/OpportunityCard.astro';
import { getPublishedOpportunities, toCardData } from '../../lib/catalog';
import { collectionJsonLd } from '../../lib/jsonld';
import { site } from '../../data/site';

const opportunities = await getPublishedOpportunities();
const cards = opportunities.map(toCardData);
---

<BaseLayout
  title="Plataformas para ganar dinero online en Argentina"
  description="Compará 25 plataformas de monetización: afiliados, publicidad, membresías y ventas. Filtrá por canal, requisitos y alta desde Argentina."
  path="/oportunidades/"
  jsonLd={[collectionJsonLd('Plataformas para ganar dinero online en Argentina', `Catálogo completo de ${site.name}.`, '/oportunidades/', cards)]}
>
  <section class="page-hero">
    <div class="container">
      <h1>Plataformas para ganar dinero online</h1>
      <p class="lede">Las {cards.length} fichas están en esta página para filtrar y comparar. Sin JavaScript seguís viendo el catálogo completo. Los filtros combinan grupos con Y, y opciones dentro de un mismo grupo con O.</p>
      <DirectoryFilters />
    </div>
  </section>
  <section class="section" style="padding-top:0.4rem">
    <div class="container">
      <div class="cards-grid" data-directory-grid>
        {cards.map((item) => <OpportunityCard item={item} />)}
      </div>
      <div class="empty-state" data-empty-state hidden>
        <h2>No hay fichas con esa combinación</h2>
        <p>Probá quitar un filtro o <a href="/oportunidades/">volver al directorio completo</a>. Un estado “pendiente de verificar” no es lo mismo que “no disponible”.</p>
      </div>
    </div>
  </section>
</BaseLayout>
<script src="../../scripts/directory.ts"></script>
