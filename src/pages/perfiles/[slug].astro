---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import OpportunityCard from '../../components/OpportunityCard.astro';
import Graphic from '../../components/Graphic.astro';
import { byChannel, featuredFirst, getPublishedOpportunities, toCardData } from '../../lib/catalog';
import { breadcrumbJsonLd, collectionJsonLd } from '../../lib/jsonld';
import { profilePath } from '../../lib/urls';
import type { ChannelId, ProfileId } from '../../data/taxonomies';

export async function getStaticPaths() {
  const profiles = await getCollection('profiles');
  const opportunities = await getPublishedOpportunities();
  return profiles.map((entry) => {
    const slug = entry.id as ProfileId;
    const items =
      slug === 'principiantes'
        ? featuredFirst(opportunities).filter((item) =>
            ['cafecito', 'mercado-libre-afiliados', 'gumroad', 'hotmart', 'adobe-stock', 'google-adsense'].includes(item.id),
          )
        : byChannel(opportunities, slug as ChannelId);
    return {
      params: { slug: entry.id },
      props: { entry, items },
    };
  });
}

const { entry, items } = Astro.props;
const { Content } = await render(entry);
const cards = items.map(toCardData);
const path = profilePath(entry.id);
const art =
  entry.id === 'aplicaciones'
    ? 'apps'
    : entry.id === 'fotografia-diseno'
      ? 'camera'
      : entry.id === 'cursos-productos'
        ? 'products'
        : entry.id === 'newsletter-comunidad'
          ? 'community'
          : 'web';
---

<ArticleLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  path={path}
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: entry.data.title },
  ]}
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Inicio', url: '/' },
      { name: entry.data.title, url: path },
    ]),
    collectionJsonLd(entry.data.seoTitle, entry.data.seoDescription, path, cards),
  ]}
>
  <p class="fact-line">{entry.data.eyebrow}</p>
  <h1>{entry.data.title}</h1>
  <div class="explain-grid" style="margin:1rem 0 1.5rem">
    <Graphic name={art} />
    <p class="lede">{entry.data.summary}</p>
  </div>
  <div class="article-body">
    <Content />
  </div>
  <h2>Qué revisar antes de elegir</h2>
  <ul>
    {entry.data.selectionTips.map((tip) => <li>{tip}</li>)}
  </ul>
  <h2>Fichas relacionadas</h2>
  <div class="cards-grid">
    {cards.map((item) => <OpportunityCard item={item} />)}
  </div>
</ArticleLayout>
