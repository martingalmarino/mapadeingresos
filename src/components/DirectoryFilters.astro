---
import { channels, eligibilityLabels, models, platformTypes } from '../data/taxonomies';

const typeOptions = Object.entries(platformTypes).map(([id, value]) => ({ id, label: value.label }));
---

<form class="filters" data-directory-filters>
  <div class="filter-bar">
    <label class="visually-hidden" for="directorio-q">Filtrar por texto</label>
    <input class="filter-search" id="directorio-q" type="search" name="q" placeholder="Buscá Shopify, afiliados, AdSense, Instagram…" autocomplete="off" enterkeyhint="search" />
    <label class="sort-field">
      <span class="visually-hidden">Orden</span>
      <select id="orden" name="sort">
        <option value="az">A-Z</option>
        <option value="editorial">Selección editorial</option>
      </select>
    </label>
  </div>
  <div class="filters-groups">
    <fieldset>
      <legend>Modelo</legend>
      <div class="chip-row start">
        {Object.entries(models).map(([id, value]) => (
          <label class="chip-check">
            <input type="checkbox" name="model" value={id} />
            <span data-tone={id}>{value.shortLabel}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset>
      <legend>Canal</legend>
      <div class="chip-row start">
        {Object.entries(channels).map(([id, value]) => (
          <label class="chip-check">
            <input type="checkbox" name="channel" value={id} />
            <span>{value.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset>
      <legend>Alta en Argentina</legend>
      <div class="chip-row start">
        {Object.entries(eligibilityLabels).map(([id, value]) => (
          <label class="chip-check">
            <input type="checkbox" name="eligibility" value={id} />
            <span data-status={id}>{value.shortLabel}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="wide">
      <legend>Tipo de plataforma</legend>
      <div class="chip-row start">
        {typeOptions.map((option) => (
          <label class="chip-check">
            <input type="checkbox" name="type" value={option.id} />
            <span>{option.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
  <div class="toolbar">
    <p class="fact-line" aria-live="polite" data-result-count></p>
    <button class="button-ghost" type="reset">Limpiar filtros</button>
  </div>
  <div class="active-chips" data-active-chips></div>
</form>
