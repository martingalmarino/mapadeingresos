---
import { footerGroups, site } from '../data/site';
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="wordmark" href="/">
        <BrandMark size={32} />
        <span class="wordmark-text">{site.name.replace('.ar', '')}<span>.ar</span></span>
      </a>
      <p>Directorio editorial de plataformas para generar ingresos online desde Argentina. No prometemos ingresos ni ranking de popularidad.</p>
    </div>
    {
      footerGroups.map((group) => (
        <div>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} {site.name}. Contenido en español de Argentina. Las condiciones de cada plataforma pueden cambiar.</p>
    <p>Desarrollado por <a href="mailto:m.galmarino@gmail.com">Martín Galmarino 🤖</a></p>
  </div>
</footer>
