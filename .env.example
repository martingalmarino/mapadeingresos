# Canonical production origin used for absolute URLs, Open Graph and the sitemap.
# Do not include a trailing slash.
PUBLIC_SITE_ORIGIN=https://www.mapadeingresos.ar

# Set to "false" on preview/staging builds so every page emits noindex
# and the sitemap is left empty. Production should omit this or set "true".
PUBLIC_SITE_INDEXING=true

# Optional public contact address. Leave empty until a real inbox exists.
# PUBLIC_CONTACT_EMAIL=
